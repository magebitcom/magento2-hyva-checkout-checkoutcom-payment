<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="main">
            <block name="checkoutcom-card-script"
                   template="Magebit_CheckoutComPayment::scripts/card.phtml"
                   ifconfig="payment/checkoutcom_card_payment/active" />
            <block name="checkoutcom-vault-script"
                   template="Magebit_CheckoutComPayment::scripts/vault.phtml"
                   ifconfig="payment/checkoutcom_vault/active" />
            <block name="checkoutcom-googlepay-script"
                   template="Magebit_CheckoutComPayment::scripts/googlepay.phtml"
                   ifconfig="payment/checkoutcom_google_pay/active" />
            <block name="checkoutcom-applepay-script"
                   template="Magebit_CheckoutComPayment::scripts/applepay.phtml"
                   ifconfig="payment/checkoutcom_apple_pay/active" />
            <block name="checkoutcom-apm-script"
                   template="Magebit_CheckoutComPayment::scripts/apm.phtml" />
            <block name="checkoutcom-klarna-script"
                   template="Magebit_CheckoutComPayment::scripts/klarna.phtml"
                   ifconfig="payment/checkoutcom_klarna/active" />
        </referenceContainer>

        <referenceBlock name="checkout.place-order"
               template="Magebit_CheckoutComPayment::navigation/place-order.phtml"
        />
    </body>
</page>
