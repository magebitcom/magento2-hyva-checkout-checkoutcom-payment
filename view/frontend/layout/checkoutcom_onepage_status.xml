<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="1column" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="columns">
            <block name="checkout.mbway.status" template="Magebit_CheckoutComPayment::component/payment/method/apm/mbway-status.phtml">
                <arguments>
                    <argument name="magewire" xsi:type="object">
                        Magebit\CheckoutComPayment\Magewire\Payment\Method\CheckoutComMBWayStatus
                    </argument>
                </arguments>
            </block>
        </referenceContainer>
        <referenceContainer name="header.container" remove="true"/>
        <referenceContainer name="footer-container" remove="true"/>
        <referenceBlock name="customer.section.config" remove="true"/>
    </body>
</page>
