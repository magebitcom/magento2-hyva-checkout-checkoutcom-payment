<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd"
>
    <body>
        <referenceBlock name="checkout.payment.methods">
            <block name="checkout.payment.method.checkoutcom.card"
                   as="checkoutcom_card_payment"
                   template="Magebit_CheckoutComPayment::component/payment/method/card.phtml"
            >
                <arguments>
                    <argument name="magewire" xsi:type="object">
                        Magebit\CheckoutComPayment\Magewire\Payment\Method\CheckoutComCard
                    </argument>
                </arguments>
            </block>
            <block name="checkout.payment.method.checkoutcom.vault"
                   as="checkoutcom_vault"
                   class="Magebit\CheckoutComPayment\Block\Payment\Vault"
                   template="Magebit_CheckoutComPayment::component/payment/method/vault.phtml"
            >
                <arguments>
                    <argument name="magewire" xsi:type="object">
                        Magebit\CheckoutComPayment\Magewire\Payment\Method\CheckoutComVault
                    </argument>
                </arguments>
            </block>
            <block name="checkout.payment.method.checkoutcom.googlepay"
                   as="checkoutcom_google_pay"
                   template="Magebit_CheckoutComPayment::component/payment/method/googlepay.phtml"
                   ifconfig="payment/checkoutcom_google_pay/active">
                <arguments>
                    <argument name="magewire" xsi:type="object">
                        Magebit\CheckoutComPayment\Magewire\Payment\Method\CheckoutComGooglePay
                    </argument>
                </arguments>
            </block>
            <block name="checkout.payment.method.checkoutcom.applepay"
                   as="checkoutcom_apple_pay"
                   template="Magebit_CheckoutComPayment::component/payment/method/applepay.phtml"
                   ifconfig="payment/checkoutcom_apple_pay/active">
                <arguments>
                    <argument name="magewire" xsi:type="object">
                        Magebit\CheckoutComPayment\Magewire\Payment\Method\CheckoutComApplePay
                    </argument>
                </arguments>
            </block>
            <block name="checkout.payment.method.checkoutcom.apm"
                   as="checkoutcom_apm"
                   template="Magebit_CheckoutComPayment::component/payment/method/apm.phtml"
                   ifconfig="payment/checkoutcom_apm/active">
                <arguments>
                    <argument name="magewire" xsi:type="object">
                        Magebit\CheckoutComPayment\Magewire\Payment\Method\CheckoutComApm
                    </argument>
                </arguments>
                <block name="checkout.payment.method.checkoutcom.apm.mbway"
                       as="checkoutcom_apm_mbway"
                       template="Magebit_CheckoutComPayment::component/payment/method/apm/mbway.phtml" />
            </block>
            <block name="checkout.payment.method.checkoutcom.klarna"
                   as="checkoutcom_klarna"
                   template="Magebit_CheckoutComPayment::component/payment/method/klarna.phtml">
            </block>
        </referenceBlock>
    </body>
</page>
