<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <preference for="Magebit\CheckoutComPayment\Api\WebhookInterface" type="Magebit\CheckoutComPayment\Model\Webhook\WebhookApi"/>

    <virtualType name="OrderLoggerHandler" type="Magento\Framework\Logger\Handler\Base">
        <arguments>
            <argument name="fileName" xsi:type="string">/var/log/testing_debug.log</argument>
        </arguments>
    </virtualType>
    <virtualType name="PaymentDebugLogger" type="Magento\Framework\Logger\Monolog">
        <arguments>
            <argument name="handlers" xsi:type="array">
                <item name="info" xsi:type="object">OrderLoggerHandler</item>
            </argument>
        </arguments>
    </virtualType>

    <type name="Magebit\CheckoutComPayment\Model\Webhook\WebhookApi">
        <arguments>
            <argument name="logger" xsi:type="object">PaymentDebugLogger</argument>
        </arguments>
    </type>
    <type name="Magebit\CheckoutComPayment\Controller\Onepage\Status">
        <arguments>
            <argument name="logger" xsi:type="object">PaymentDebugLogger</argument>
        </arguments>
    </type>
    <type name="Magebit\CheckoutComPayment\Magewire\Payment\Method\CheckoutComMBWayStatus">
        <arguments>
            <argument name="logger" xsi:type="object">PaymentDebugLogger</argument>
        </arguments>
    </type>
</config>
