<csp_whitelist xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Csp/etc/csp_whitelist.xsd">
    <policies>
        <policy id="script-src">
            <values>
                <value id="google-pay" type="host">https://pay.google.com</value>
                <value id="google-base" type="host">https://google.com</value>
                <value id="google-general" type="host">https://*.google.com</value>
                <value id="cko-cdn" type="host">https://*.checkout.com</value>
            </values>
        </policy>
        <policy id="connect-src">
            <values>
                <value id="google-pay" type="host">https://pay.google.com</value>
                <value id="google-base" type="host">https://google.com</value>
                <value id="google-general" type="host">https://*.google.com</value>
            </values>
        </policy>
        <policy id="frame-src">
            <values>
                <value id="google-pay" type="host">https://pay.google.com</value>
                <value id="google-base" type="host">https://google.com</value>
                <value id="google-general" type="host">https://*.google.com</value>
                <value id="klarnaservices" type="host">https://*.klarnaservices.com</value>
            </values>
        </policy>
        <policy id="img-src">
            <values>
                <value id="google-pay-img" type="host">https://pay.google.com</value>
                <value id="google-base-img" type="host">https://google.com</value>
                <value id="google-general-img" type="host">https://*.google.com</value>
                <value id="google-static-img" type="host">https://*.gstatic.com</value>
                <value id="klarna-favicon" type="host">https://x.klarnacdn.net</value>
            </values>
        </policy>
        <policy id="frame-ancestors">
            <values>
                <value id="google-pay-ancestors" type="host">https://pay.google.com</value>
                <value id="google-base-ancestors" type="host">https://google.com</value>
                <value id="google-general-ancestors" type="host">https://*.google.com</value>
            </values>
        </policy>
    </policies>
</csp_whitelist>
