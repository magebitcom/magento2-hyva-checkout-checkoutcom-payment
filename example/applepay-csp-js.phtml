declare(strict_types=1);

use Hyva\Theme\Model\ViewModelRegistry;
use Hyva\Theme\ViewModel\HyvaCsp;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use Hyva\BraintreeHyvaCheckout\ViewModel\Braintree as BraintreeViewModel;
use Hyva\BraintreeHyvaCheckout\ViewModel\Payment\Method\ApplePay as ApplePayViewModel;

/** @var Template $block */
/** @var Escaper $escaper */
/** @var ViewModelRegistry $viewModels */
/** @var HyvaCsp $hyvaCsp */

/** @var BraintreeViewModel $braintreeViewModel */
$braintreeViewModel = $viewModels->require(BraintreeViewModel::class);
/** @var ApplePayViewModel $applePayViewModel */
$applePayViewModel = $viewModels->require(ApplePayViewModel::class);
?>
<script>
    (function() {
        "use strict";

        // Global variables and functions setup
        let applePayComponent;
        const braintreeApplePayId = "braintreeApplePay";

        // Initialize window.braintree at top level
        window.braintree = window.braintree || {};
        window.braintree.events = [];

        // Global helper functions
        window.braintree.trackEvent = function(eventName, eventData = {}) {
            const event = {
                event: eventName,
                data: eventData
            };
            window.braintree.events.push(event);
        };

        window.braintree.logEvents = function() {
            if (applePayComponent && window.braintree.events.length) {
                applePayComponent.call('logEvents', window.braintree.events);
                window.braintree.events = [];
            }
        };

        function createScriptLoadPromise(url) {
            return new Promise((resolve, reject) => {
                const script = document.createElement('script');
                script.src = url;
                script.onload = resolve;
                script.onerror = reject;
                document.head.appendChild(script);
            });
        }

        function showLoader() {
            window.dispatchEvent(new Event('magewire:loader:start'));
        }

        function hideLoader() {
            window.dispatchEvent(new Event('magewire:loader:done'));
        }

        function showError(message) {
            hideLoader();
            console.error('Braintree Apple Pay Error:', message);
            hyvaCheckout.payment.dispatchExceptionMessage(message, 'error');
            window.dispatchEvent(new CustomEvent('braintree-payment-error'));
        }

        function clearError() {
            hyvaCheckout.payment.dispatchSuccessMessage('');
        }

        // Main Apple Pay activation function
        window.braintree.activateApplePay = async function () {
            window.braintree.trackEvent('activate_applepay_start');

            if (!window.ApplePaySession || !window.ApplePaySession.canMakePayments()) {
                return;
            }

            const applePayContainer = document.getElementById(braintreeApplePayId);

            if (applePayContainer) {
                const closestLi = applePayContainer.closest('li');
                if (closestLi) {
                    closestLi.classList.add('braintree-applepay-visible');
                }
            }

            const requiredJsFiles = [];

            if (!window.braintree?.client) {
                requiredJsFiles.push(createScriptLoadPromise('https://js.braintreegateway.com/web/3.92.2/js/client.min.js'));
            }

            if (!window.braintree?.applePay) {
                requiredJsFiles.push(createScriptLoadPromise('https://js.braintreegateway.com/web/3.92.2/js/apple-pay.min.js'));
            }

            const componentName = 'checkout.payment.method.applepay';
            applePayComponent = Magewire.find(componentName);

            try {
                await Promise.all(requiredJsFiles);
                await initialiseApplePay();
                addEvents();
            } catch (error) {
                console.error('Apple Pay activation failed:', error);
                showError('Error initializing Apple Pay');
            }
        };

        async function initialiseApplePay() {
            window.braintree.trackEvent('initialize_applepay_start');

            if (window.braintree.applePayToken) {
                window.braintree.trackEvent('applepay_token_already_exists');
                return;
            }

            try {
                const clientInstance = await window.braintree.client.create({
                    authorization: "<?= $escaper->escapeJs($braintreeViewModel->getClientToken()) ?>",
                });

                const applePayInstance = await window.braintree.applePay.create({
                    client: clientInstance,
                });

                const applePayButton = document.createElement('apple-pay-button');

                applePayButton.setAttribute('buttonstyle', 'black');
                applePayButton.setAttribute('type', 'plain');
                applePayButton.setAttribute('locale', 'en');

                applePayButton.addEventListener('click', (e) => {
                    window.braintree.trackEvent('applepay_button_clicked');
                    window.braintree.logEvents();
                    showLoader();

                    var paymentRequest = applePayInstance.createPaymentRequest({
                        total: {
                            label: '<?= $escaper->escapeJs($applePayViewModel->getMerchantName()); ?>',
                            amount: applePayComponent.get('amount').toString(),
                        },
                        currencyCode: '<?= $escaper->escapeJs($braintreeViewModel->getCurrency()) ?>',
                    });

                    if (!paymentRequest) {
                        showError('<?= $escaper->escapeJs(__('Braintree ApplePay unable to create paymentRequest.')) ?>');
                        return;
                    }

                    try {
                        var session = new ApplePaySession(3, paymentRequest);

                        session.onvalidatemerchant = function(event) {
                            applePayInstance.performValidation({
                                validationURL: event.validationURL,
                                displayName: '<?= $escaper->escapeJs($applePayViewModel->getMerchantName()); ?>',
                            }, function(validationErr, merchantSession) {
                                if (validationErr) {
                                    session.abort();
                                    showError('<?= $escaper->escapeJs(__('Error validating merchant.')) ?>');
                                    return;
                                }

                                session.completeMerchantValidation(merchantSession);
                            });
                        };

                        session.oncancel = function() {
                            showError('<?= $escaper->escapeJs(__('Payment cancelled.')) ?>');
                        }

                        session.onpaymentauthorized = function(event) {
                            window.braintree.trackEvent('payment_authorized', {
                                hasToken: !!event.payment.token
                            });

                            applePayInstance.tokenize({
                                token: event.payment.token
                            }, function(tokenizeErr, payload) {
                                if (tokenizeErr) {
                                    showError('Payment processing failed. Please try again.');
                                    session.completePayment(ApplePaySession.STATUS_FAILURE);
                                    return;
                                }

                                window.braintree.applePayToken = true;
                                window.dispatchEvent(new CustomEvent('braintree-set-apple-token', {
                                    detail: { applePayToken: true }
                                }));

                                applePayComponent.call('setToken', payload.nonce);
                                window.braintree.trackEvent('token_set_success');
                                applePayComponent.call('placeOrder');
                                window.braintree.logEvents();
                                clearError();
                                session.completePayment(ApplePaySession.STATUS_SUCCESS);
                            });
                        };

                        session.begin();

                    } catch (err) {
                        const errorDetails = err.message || 'Unknown error';
                        console.error('Apple Pay session error:', err);
                        showError('<?= $escaper->escapeJs(__('Unable to create Apple Pay session:')) ?> ' + errorDetails);
                    }
                });

                const applePayElement = document.getElementById('braintreeApplePayButton');

                if (applePayElement && !applePayElement.childElementCount) {
                    applePayElement.append(applePayButton);
                    applePayButton.style.cssText = `-webkit-appearance: -apple-pay-button; height: 40px; width: 100%;`;
                }

            } catch (error) {
                window.braintree.trackEvent('initialize_error', {
                    error: error.message
                });
                await window.braintree.logEvents();
                throw error;
            }
        }

        function addEvents() {
            try {
                window.addEventListener('checkout:init:after', event => {
                    hyvaCheckout.validation.register(braintreeApplePayId, async function () {
                        if (!window.braintree.applePayToken) {
                            showError('<?= $escaper->escapeJs(__('Please complete payment validation with Apple Pay first.')) ?>');
                        }
                        return window.braintree.applePayToken || false;
                    }, document.getElementById(braintreeApplePayId));
                }, {
                    once: true
                });

                window.Magewire.hook('message.processed', (message, component) => {
                    if (component.id === 'checkout.billing-details.address-list') {
                        window.braintree.applePayToken = false;
                    }
                });

            } catch (error) {
                console.error('Error adding Apple Pay events:', error);
            }
        }

        // Alpine component function
        function braintreeCheckoutApplepay() {
            return {
                applePayToken: false,
                paymentMessage: '',
                hasError: false,

                ['!applePayToken']() {
                    return !this.applePayToken;
                },

                withoutError() {
                    return !this.hasError;
                },

                initApplePay() {
                    // Initialize Apple Pay when component loads
                    if (window.braintree && typeof window.braintree.activateApplePay === 'function') {
                        window.braintree.activateApplePay();
                    } else {
                        // Retry after a short delay if braintree isn't ready yet
                        setTimeout(() => {
                            if (window.braintree && typeof window.braintree.activateApplePay === 'function') {
                                window.braintree.activateApplePay();
                            }
                        }, 100);
                    }
                },

                onAppleTokenSet() {
                    this.applePayToken = this.$event.detail.applePayToken;
                    this.paymentMessage = 'Thank you, we started to process your order';
                    this.hasError = false;
                },

                onPaymentError() {
                    this.hasError = true;
                }
            };
        }

        window.addEventListener('alpine:init', () => {
            Alpine.data('braintreeCheckoutApplepay', braintreeCheckoutApplepay);
        }, {once: true});
    })();
</script>
<?php $hyvaCsp->registerInlineScript() ?>
